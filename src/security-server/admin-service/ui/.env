VITE_VUE_APP_TITLE=Lesotho Exchange Security Server
# Lesotho Exchange ministry branding (shared-ui/src/branding.ts); override per server at build time,
# e.g. VITE_BRAND_MINISTRY=micsti for the management services security server.
VITE_BRAND_MINISTRY=moh
VITE_BRAND_SHOW_FLAG=true
VITE_VUE_APP_BASE_URL=https://localhost:8080/api/v1
VITE_VUE_APP_AUTH_URL=https://localhost:8080

VITE_VUE_APP_I18N_LOCALE=en
VITE_VUE_APP_I18N_FALLBACK_LOCALE=en
VITE_I18N_STOP_USER_LOCALE=false
VITE_WARN_MISSING_TRANSLATION=true
